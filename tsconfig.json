{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "eventsource": ["./node_modules/eventsource/dist/index.d.ts"],
      "eventsource-parser": ["./node_modules/eventsource-parser/dist/index.d.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/tsup.config.ts",
    "scripts",
    "test",
    "*.config.ts",
    "tsup.shared.ts"
  ]
}
