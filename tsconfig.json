{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@catspec/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/tsup.config.ts",
    "scripts",
    "test",
    "*.config.ts",
    "tsup.shared.ts"
  ]
}
