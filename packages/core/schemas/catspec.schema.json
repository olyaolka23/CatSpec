{
  "title": "catspec.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "description": "Config format version.",
      "type": "number",
      "const": 1
    },
    "layout": {
      "default": "feature-folders",
      "description": "feature-folders: specs live in docs/spec/<feature>/ (CS0106 otherwise).",
      "type": "string",
      "enum": ["feature-folders", "free"]
    },
    "workflow": {
      "default": {},
      "type": "object",
      "properties": {
        "preset": {
          "default": "catspec",
          "description": "A ready-made profile, or custom.",
          "type": "string",
          "enum": ["catspec", "openspec", "spec-kit", "custom"]
        },
        "allow_commands": {
          "default": false,
          "description": "Let `command:` gates run commands (without a shell).",
          "type": "boolean"
        },
        "enforce_in_hook": {
          "default": "warn",
          "description": "Re-check implemented specs' final gates in the pre-commit hook (CS0703).",
          "type": "string",
          "enum": ["off", "warn", "error"]
        },
        "feature_dir": {
          "description": "Where features live, e.g. \"docs/spec/{feature}\", or a list for features at several depths (domain folders): [\"docs/spec/billing/{feature}\", \"docs/spec/{feature}\"].",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "skills_dir": {
          "description": "Where `skill:` drivers are found.",
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "description": "The stages, in order; replaces the preset's stages.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "per": {
                "default": "feature",
                "description": "feature: once for the feature folder; spec: once per work item (spec).",
                "type": "string",
                "enum": ["feature", "spec"]
              },
              "driver": {
                "default": "manual",
                "anyOf": [
                  { "type": "string", "const": "manual" },
                  {
                    "type": "object",
                    "properties": {
                      "skill": {
                        "type": "string",
                        "minLength": 1,
                        "description": "An agent skill, in skills_dir."
                      }
                    },
                    "required": ["skill"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "slash": {
                        "type": "string",
                        "minLength": 1,
                        "description": "An agent slash command."
                      }
                    },
                    "required": ["slash"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A command the person or agent runs."
                      }
                    },
                    "required": ["command"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "manual": {
                        "type": "string",
                        "minLength": 1,
                        "description": "What the person does."
                      }
                    },
                    "required": ["manual"],
                    "additionalProperties": false
                  }
                ],
                "description": "Who performs the stage."
              },
              "produces": {
                "default": [],
                "description": "Path templates of the stage's artifacts.",
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "start": {
                "default": {},
                "type": "object",
                "properties": {
                  "gates": {
                    "default": [],
                    "description": "Gates that must pass.",
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "specs_valid",
                            "artifacts",
                            "contracts_declared",
                            "deps_known",
                            "deps_ready",
                            "contracts_pass",
                            "tasks_done",
                            "no_drift",
                            "adr_valid"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "command": {
                              "type": "string",
                              "minLength": 1,
                              "description": "A command that must exit with 0, run without a shell; only with workflow.allow_commands."
                            }
                          },
                          "required": ["command"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "status": {
                    "description": "The status the stage's specs get when the gates pass.",
                    "type": "string",
                    "enum": ["draft", "ready", "in-progress", "implemented", "deprecated"]
                  }
                },
                "additionalProperties": false
              },
              "finish": {
                "default": {},
                "type": "object",
                "properties": {
                  "gates": {
                    "default": [],
                    "description": "Gates that must pass.",
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "specs_valid",
                            "artifacts",
                            "contracts_declared",
                            "deps_known",
                            "deps_ready",
                            "contracts_pass",
                            "tasks_done",
                            "no_drift",
                            "adr_valid"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "command": {
                              "type": "string",
                              "minLength": 1,
                              "description": "A command that must exit with 0, run without a shell; only with workflow.allow_commands."
                            }
                          },
                          "required": ["command"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "status": {
                    "description": "The status the stage's specs get when the gates pass.",
                    "type": "string",
                    "enum": ["draft", "ready", "in-progress", "implemented", "deprecated"]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Workflow profile (plan §D17)."
    },
    "specs": {
      "default": {},
      "type": "object",
      "properties": {
        "include": {
          "default": ["docs/spec/*/*.spec.md"],
          "description": "Machine spec files.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "architecture": {
          "default": "docs/architecture/adr/*-adr.md",
          "description": "The architecture spec (ADR log); exactly one file must match (CS0107).",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "default": {},
      "type": "object",
      "properties": {
        "typescript": {
          "default": {},
          "type": "object",
          "properties": {
            "include": {
              "default": ["src/**/*.{ts,tsx}"],
              "description": "Source files of this language (globs).",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "default": ["**/*.d.ts", "**/node_modules/**"],
              "description": "Files to leave out (globs).",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "csharp": {
          "default": {},
          "type": "object",
          "properties": {
            "include": {
              "default": ["src/**/*.cs"],
              "description": "Source files of this language (globs).",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "default": ["**/obj/**", "**/bin/**", "**/*.g.cs"],
              "description": "Files to leave out (globs).",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "default": {},
      "type": "object",
      "properties": {
        "drift": { "default": "warn", "type": "string", "enum": ["off", "warn", "strict"] },
        "unresolvable": { "default": "warn", "type": "string", "enum": ["warn", "error"] },
        "unenforced_prose": { "default": "warn", "type": "string", "enum": ["off", "warn"] }
      },
      "additionalProperties": false
    },
    "tests": {
      "default": {},
      "type": "object",
      "properties": {
        "command": {
          "description": "Test command run by `check --run-tests` for each test rule, without a shell: a string split at spaces, or a list of arguments. `{test}` is replaced with the test symbol.",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        }
      },
      "additionalProperties": false
    },
    "heal": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": { "default": "suggest", "type": "string", "enum": ["off", "suggest", "auto"] },
        "threshold": { "default": 0.8, "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "hook": {
      "default": {},
      "type": "object",
      "properties": {
        "stage_generated": {
          "default": true,
          "description": "Re-stage lock files and auto-healed specs.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "refactor": {
      "default": {},
      "type": "object",
      "properties": {
        "detect_threshold": {
          "default": 10,
          "description": "Broken bindings in one commit that count as a large refactor.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "allow_wip": { "default": false, "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mcp": {
      "default": {},
      "type": "object",
      "properties": {
        "allow_location_edits": { "default": true, "type": "boolean" },
        "allow_contract_edits": { "default": false, "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "CatSpec configuration (catspec.yaml)."
}
