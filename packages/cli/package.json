{
  "name": "@catspec/cli",
  "version": "0.1.0",
  "description": "The catspec command-line interface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olyaolka23/CatSpec.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/olyaolka23/CatSpec#readme",
  "bugs": "https://github.com/olyaolka23/CatSpec/issues",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": {
      "source": "./src/bin.ts",
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "catspec": "./dist/bin.js"
  },
  "files": [
    "dist",
    "guide"
  ],
  "scripts": {
    "build": "node scripts/copy-guide.js && tsup"
  },
  "dependencies": {
    "@catspec/core": "0.1.0",
    "@catspec/lang": "0.1.0",
    "@catspec/lang-csharp": "0.1.0",
    "@catspec/lang-typescript": "0.1.0",
    "@catspec/mcp": "0.1.0",
    "commander": "^15.0.0"
  }
}
