{
  "name": "@catspec/lang-typescript",
  "version": "0.0.0",
  "description": "TypeScript/TSX language adapter for CatSpec.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "grammars"
  ],
  "scripts": {
    "build": "node scripts/build-grammars.js && tsup"
  },
  "dependencies": {
    "@catspec/core": "0.0.0",
    "@catspec/lang": "0.0.0"
  },
  "devDependencies": {
    "tree-sitter-wasms": "0.1.13"
  }
}
