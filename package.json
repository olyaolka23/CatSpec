{
  "name": "catspec-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/lang",
    "packages/lang-typescript",
    "packages/lang-csharp",
    "packages/cli",
    "packages/mcp",
    "packages/catspec"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "check:acceptance": "tsx scripts/check-acceptance.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
